{
  "name": "pokepath",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "pokemon:transparent": "node scripts/makePokemonPngsTransparent.mjs",
    "supabase:start": "npx supabase start --workdir ..",
    "supabase:stop": "npx supabase stop --workdir ..",
    "supabase:status": "npx supabase status --workdir ..",
    "supabase:reset": "npx supabase db reset --workdir ..",
    "supabase:link": "npx supabase link --project-ref \"$SUPABASE_PROJECT_REF\" -p \"$SUPABASE_DB_PASSWORD\" --workdir .. --yes",
    "supabase:migration:list": "bash ../scripts/ensure-supabase-linked.sh && npx supabase migration list --linked --workdir ..",
    "supabase:db:push": "bash ../scripts/ensure-supabase-linked.sh && npx supabase db push --linked --workdir .. --yes",
    "supabase:db:push:dry-run": "bash ../scripts/ensure-supabase-linked.sh && npx supabase db push --linked --dry-run --workdir ..",
    "supabase:migration:repair-reverted": "bash ../scripts/ensure-supabase-linked.sh && sh -c 'v=\"${SUPABASE_MIGRATION_VERSION:-20260418150000}\"; npx supabase migration repair --status reverted \"$v\" --linked --workdir .. --yes'",
    "supabase:migration:repair-applied": "bash ../scripts/ensure-supabase-linked.sh && sh -c 'test -n \"$SUPABASE_MIGRATION_VERSION\" || (echo \"Set SUPABASE_MIGRATION_VERSION (e.g. 20260415120000)\" >&2; exit 1); npx supabase migration repair --status applied \"$SUPABASE_MIGRATION_VERSION\" --linked --workdir .. --yes'",
    "supabase:migration:mark-all-applied": "bash ../scripts/supabase-mark-applied-local-migrations.sh",
    "supabase:db:pull": "bash ../scripts/ensure-supabase-linked.sh && npx supabase db pull --workdir .."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "framer-motion": "^12.38.0",
    "immer": "^11.1.4",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
